APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nominatim, el geocodificador de OpenStreetMap: es lo que pone calle + altura
# en el mapa. La instancia pública pide un User-Agent que identifique la
# aplicación y no más de una consulta por segundo; si el tráfico crece, esto
# apunta a una instancia propia.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_AGENTE="worldstreets.global (+https://worldstreets.global)"
NOMINATIM_TIMEOUT=6

# El dominio real del sitio. Los canonical y los <loc> de los sitemaps se
# escriben contra este host, y cualquier otro host que sirva la aplicación
# —el dominio de pruebas del corte— responde con X-Robots-Tag: noindex.
# Vacío en desarrollo: apaga el mecanismo.
CANONICAL_HOST=

# Google Analytics 4, `G-...`. Es la propiedad que venía midiendo el
# CakePHP: conservarla mantiene el histórico, que en un sitio que viene de una
# caída algorítmica es el dato con el que se compara todo lo demás.
# Vacío apaga la medición, que es lo que corresponde en local y en los tests.
ANALYTICS_ID=

# AdSense: el ID de editor, `ca-pub-...`. Es la única fuente de ingresos del
# sitio. Vacío apaga los anuncios enteros, que es lo que corresponde en local.
# Los data-ad-slot de cada unidad van en las vistas, no acá.
CONTACT_EMAIL=
ADSENSE_CLIENT=

# Los data-ad-slot de cada unidad, del panel de AdSense. Cada uno vacío apaga
# su bloque y deja los otros andando, que es lo que permite montarlas de a una
# y medir cada posición por separado.
#
# Ficha de ciudad. La de _INDICE se intercala dentro del índice A–Z y es la
# que atiende el problema real de esta página: en un teléfono son 58 pantallas
# de scroll, y sin ella las 56 del medio no llevan un solo anuncio.
ADSENSE_SLOT_CIUDAD_SUPERIOR=
ADSENSE_SLOT_CIUDAD_MEDIO=
ADSENSE_SLOT_CIUDAD_INDICE=
ADSENSE_SLOT_CIUDAD_FINAL=

# Ficha de país: la página más eficiente del sitio (12 clics por URL contra
# 5,2 de la ficha de ciudad) y la que la migración dejó sin monetizar.
ADSENSE_SLOT_PAIS_SUPERIOR=
ADSENSE_SLOT_PAIS_MEDIO=

# Cada cuántos grupos de letra se intercala una unidad en el índice A–Z.
# Con 27 grupos —una ciudad grande— 8 da tres unidades intercaladas. Bajarlo
# las aumenta. Ver el comentario en config/services.php antes de tocarlo.
ADSENSE_INDICE_CADA=8
